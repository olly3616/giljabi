{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/cards/**",
              "components/core/**",
              "components/feedback/**",
              "components/overlay/**",
              "ui_kits/android_app/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Pretendard))/i]",
        "message": "Font not provided by the design system. Available: Pretendard."
      },
      {
        "selector": "JSXOpeningElement[name.name='BigButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|variant|size|icon|iconEnd|disabled|fullWidth|style|key|ref|className|style|children)$/]",
        "message": "<BigButton> doesn't accept that prop. Declared props: children, variant, size, icon, iconEnd, disabled, fullWidth, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='BigButton'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|secondary|accent|quiet)$/]",
        "message": "<BigButton> variant must be one of 'primary' | 'secondary' | 'accent' | 'quiet'."
      },
      {
        "selector": "JSXOpeningElement[name.name='BigButton'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:hero|comfortable|small)$/]",
        "message": "<BigButton> size must be one of 'hero' | 'comfortable' | 'small'."
      },
      {
        "selector": "JSXOpeningElement[name.name='CompletionBadge'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|subtitle|icon|tone|size|illustration|style|key|ref|className|style|children)$/]",
        "message": "<CompletionBadge> doesn't accept that prop. Declared props: title, subtitle, icon, tone, size, illustration, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='CompletionBadge'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:success|accent)$/]",
        "message": "<CompletionBadge> tone must be one of 'success' | 'accent'."
      },
      {
        "selector": "JSXOpeningElement[name.name='GoalCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|label|caption|tone|selected|style|key|ref|className|style|children)$/]",
        "message": "<GoalCard> doesn't accept that prop. Declared props: icon, label, caption, tone, selected, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='GoalCard'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:brand|accent|calm)$/]",
        "message": "<GoalCard> tone must be one of 'brand' | 'accent' | 'calm'."
      },
      {
        "selector": "JSXOpeningElement[name.name='HighlightRing'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|shape|pulse|label|width|height|style|key|ref|className|style|children)$/]",
        "message": "<HighlightRing> doesn't accept that prop. Declared props: children, shape, pulse, label, width, height, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='HighlightRing'] > JSXAttribute[name.name='shape'] > Literal[value!=/^(?:rect|pill|circle)$/]",
        "message": "<HighlightRing> shape must be one of 'rect' | 'pill' | 'circle'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|size|color|strokeWidth|label|key|ref|className|style|children)$/]",
        "message": "<Icon> doesn't accept that prop. Declared props: name, size, color, strokeWidth, label."
      },
      {
        "selector": "JSXOpeningElement[name.name='Mascot'] > JSXAttribute > JSXIdentifier[name!=/^(?:state|size|facing|frozen|style|key|ref|className|style|children)$/]",
        "message": "<Mascot> doesn't accept that prop. Declared props: state, size, facing, frozen, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Mascot'] > JSXAttribute[name.name='state'] > Literal[value!=/^(?:idle|walk|walk_1|walk_2|point|celebrate)$/]",
        "message": "<Mascot> state must be one of 'idle' | 'walk' | 'walk_1' | 'walk_2' | 'point' | 'celebrate'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Mascot'] > JSXAttribute[name.name='facing'] > Literal[value!=/^(?:left|right)$/]",
        "message": "<Mascot> facing must be one of 'left' | 'right'."
      },
      {
        "selector": "JSXOpeningElement[name.name='PermissionCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:step|title|description|icon|illustration|status|style|key|ref|className|style|children)$/]",
        "message": "<PermissionCard> doesn't accept that prop. Declared props: step, title, description, icon, illustration, status, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='PermissionCard'] > JSXAttribute[name.name='status'] > Literal[value!=/^(?:todo|done)$/]",
        "message": "<PermissionCard> status must be one of 'todo' | 'done'."
      },
      {
        "selector": "JSXOpeningElement[name.name='PointerArrow'] > JSXAttribute > JSXIdentifier[name!=/^(?:direction|size|nudge|style|key|ref|className|style|children)$/]",
        "message": "<PointerArrow> doesn't accept that prop. Declared props: direction, size, nudge, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='PointerArrow'] > JSXAttribute[name.name='direction'] > Literal[value!=/^(?:up|down|left|right)$/]",
        "message": "<PointerArrow> direction must be one of 'up' | 'down' | 'left' | 'right'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SpeechBubble'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|tail|tailOffset|tone|width|style|key|ref|className|style|children)$/]",
        "message": "<SpeechBubble> doesn't accept that prop. Declared props: children, tail, tailOffset, tone, width, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SpeechBubble'] > JSXAttribute[name.name='tail'] > Literal[value!=/^(?:top|bottom|left|right)$/]",
        "message": "<SpeechBubble> tail must be one of 'top' | 'bottom' | 'left' | 'right'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SpeechBubble'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:default|accent)$/]",
        "message": "<SpeechBubble> tone must be one of 'default' | 'accent'."
      },
      {
        "selector": "JSXOpeningElement[name.name='TextField'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|hint|error|icon|style|key|ref|className|style|children)$/]",
        "message": "<TextField> doesn't accept that prop. Declared props: label, hint, error, icon, style."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
