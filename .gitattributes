# Normalize line endings — keep the repo consistent across OSes.
* text=auto eol=lf

# Windows-only scripts keep CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

# Gradle wrapper script is POSIX sh
gradlew text eol=lf

# Binary assets — never normalize
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.gif binary
*.ttf binary
*.otf binary
*.jar binary
*.keystore binary
*.jks binary
