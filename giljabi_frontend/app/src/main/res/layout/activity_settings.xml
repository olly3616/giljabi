<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_page"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/screen_padding">

        <TextView
            style="@style/Text.Giljabi.Title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_6"
            android:layout_marginBottom="@dimen/space_5"
            android:text="@string/settings_title" />

        <!-- 마스코트 -->
        <com.google.android.material.card.MaterialCardView
            style="@style/CardSection">
            <LinearLayout style="@style/CardBody">
                <TextView style="@style/Text.Giljabi.Heading" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/set_mascot_section" />

                <LinearLayout style="@style/SettingRow">
                    <LinearLayout style="@style/RowText">
                        <TextView style="@style/Text.Giljabi.Body" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/set_floating" />
                        <TextView style="@style/Text.Giljabi.Caption" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/set_floating_desc" />
                    </LinearLayout>
                    <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/switchFloating" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                </LinearLayout>

                <TextView style="@style/Text.Giljabi.Body" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_4" android:text="@string/set_mascot_size" />
                <LinearLayout style="@style/SliderRow">
                    <TextView style="@style/SliderEnd" android:text="@string/set_small" />
                    <com.google.android.material.slider.Slider android:id="@+id/sliderMascot" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:valueFrom="0.7" android:valueTo="1.6" android:stepSize="0.1" android:value="1.0" />
                    <TextView style="@style/SliderEnd" android:text="@string/set_large" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 말풍선 -->
        <com.google.android.material.card.MaterialCardView style="@style/CardSection">
            <LinearLayout style="@style/CardBody">
                <TextView style="@style/Text.Giljabi.Heading" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/set_bubble_section" />

                <LinearLayout style="@style/SettingRow">
                    <TextView style="@style/Text.Giljabi.Body" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/set_bubble_show" />
                    <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/switchBubble" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                </LinearLayout>

                <TextView style="@style/Text.Giljabi.Body" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_4" android:text="@string/set_bubble_size" />
                <LinearLayout style="@style/SliderRow">
                    <TextView style="@style/SliderEnd" android:text="@string/set_small" />
                    <com.google.android.material.slider.Slider android:id="@+id/sliderBubble" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:valueFrom="0.8" android:valueTo="1.7" android:stepSize="0.1" android:value="1.0" />
                    <TextView style="@style/SliderEnd" android:text="@string/set_large" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 마커 -->
        <com.google.android.material.card.MaterialCardView style="@style/CardSection">
            <LinearLayout style="@style/CardBody">
                <TextView style="@style/Text.Giljabi.Heading" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/set_marker_section" />

                <TextView style="@style/Text.Giljabi.Body" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_3" android:text="@string/set_marker_color" />
                <com.google.android.material.button.MaterialButtonToggleGroup
                    android:id="@+id/toggleColor" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_2" app:singleSelection="true" app:selectionRequired="true">
                    <com.google.android.material.button.MaterialButton android:id="@+id/colorAmber" style="@style/Widget.Material3.Button.IconButton.Filled" android:layout_width="56dp" android:layout_height="56dp" app:backgroundTint="#F5A524" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/colorBlue" style="@style/Widget.Material3.Button.IconButton.Filled" android:layout_width="56dp" android:layout_height="56dp" app:backgroundTint="#1A4FD0" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/colorRed" style="@style/Widget.Material3.Button.IconButton.Filled" android:layout_width="56dp" android:layout_height="56dp" app:backgroundTint="#C42B1C" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/colorGreen" style="@style/Widget.Material3.Button.IconButton.Filled" android:layout_width="56dp" android:layout_height="56dp" app:backgroundTint="#12894A" />
                </com.google.android.material.button.MaterialButtonToggleGroup>

                <TextView style="@style/Text.Giljabi.Body" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_4" android:text="@string/set_marker_line" />
                <com.google.android.material.button.MaterialButtonToggleGroup
                    android:id="@+id/toggleLine" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_2" app:singleSelection="true" app:selectionRequired="true">
                    <com.google.android.material.button.MaterialButton android:id="@+id/btnSolid" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="0dp" android:layout_weight="1" android:layout_height="56dp" android:text="@string/set_line_solid" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/btnDashed" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="0dp" android:layout_weight="1" android:layout_height="56dp" android:text="@string/set_line_dashed" />
                </com.google.android.material.button.MaterialButtonToggleGroup>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 음성 -->
        <com.google.android.material.card.MaterialCardView style="@style/CardSection">
            <LinearLayout style="@style/CardBody">
                <TextView style="@style/Text.Giljabi.Heading" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/set_voice_section" />

                <LinearLayout style="@style/SettingRow">
                    <TextView style="@style/Text.Giljabi.Body" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/set_voice_on" />
                    <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/switchVoice" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                </LinearLayout>

                <TextView style="@style/Text.Giljabi.Body" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_4" android:text="@string/set_voice_rate" />
                <LinearLayout style="@style/SliderRow">
                    <TextView style="@style/SliderEnd" android:text="@string/set_slow" />
                    <com.google.android.material.slider.Slider android:id="@+id/sliderRate" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:valueFrom="0.5" android:valueTo="1.5" android:stepSize="0.1" android:value="1.0" />
                    <TextView style="@style/SliderEnd" android:text="@string/set_fast" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnTtsSettings" android:layout_width="match_parent" android:layout_height="@dimen/touch_comfortable" android:layout_marginTop="@dimen/space_4"
                    style="@style/Widget.Material3.Button.TonalButton" android:text="@string/set_tts_open" android:textSize="@dimen/text_body" app:cornerRadius="@dimen/radius_md" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</ScrollView>
