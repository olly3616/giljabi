<?xml version="1.0" encoding="utf-8"?>
<!--
  안내 오버레이: 대상 하이라이트 링 + 그 근처로 이동하는 마스코트 + 말풍선.
  마스코트/말풍선 위치는 코드(OverlayController)에서 translation 으로 대상 옆에 배치.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:importantForAccessibility="no">

    <kr.olly.giljabi.overlay.HighlightRingView
        android:id="@+id/ring"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <TextView
        android:id="@+id/bubble"
        style="@style/Text.Giljabi.Guide"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_speech_bubble"
        android:elevation="8dp"
        android:maxWidth="240dp"
        android:paddingHorizontal="@dimen/space_5"
        android:paddingVertical="@dimen/space_4"
        android:textColor="@color/overlay_bubble_ink" />

    <ImageView
        android:id="@+id/mascot"
        android:layout_width="96dp"
        android:layout_height="96dp"
        android:contentDescription="@string/mascot_desc"
        android:elevation="8dp"
        android:scaleType="fitCenter"
        android:src="@drawable/mascot_guide" />
</FrameLayout>
