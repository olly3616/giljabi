<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_page"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/screen_padding">

        <TextView
            style="@style/Text.Giljabi.Title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_8"
            android:text="@string/setup_title" />

        <TextView
            style="@style/Text.Giljabi.Body"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_3"
            android:textColor="@color/text_secondary"
            android:text="@string/setup_intro" />

        <!-- ① 접근성 권한 카드 -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_8"
            app:cardBackgroundColor="@color/surface_card"
            app:cardCornerRadius="@dimen/radius_lg"
            app:strokeColor="@color/border_subtle"
            app:strokeWidth="@dimen/border_width">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/space_6">

                <TextView
                    style="@style/Text.Giljabi.Heading"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/perm_a11y_title" />

                <TextView
                    style="@style/Text.Giljabi.Body"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_2"
                    android:textColor="@color/text_secondary"
                    android:text="@string/perm_a11y_desc" />

                <TextView
                    android:id="@+id/tvA11yStatus"
                    style="@style/Text.Giljabi.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_3"
                    tools:text="상태: 꺼짐" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnA11y"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/touch_comfortable"
                    android:layout_marginTop="@dimen/space_4"
                    android:text="@string/btn_open_a11y"
                    android:textSize="@dimen/text_button"
                    app:cornerRadius="@dimen/radius_md" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ② 오버레이 권한 카드 -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/stack_gap"
            app:cardBackgroundColor="@color/surface_card"
            app:cardCornerRadius="@dimen/radius_lg"
            app:strokeColor="@color/border_subtle"
            app:strokeWidth="@dimen/border_width">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/space_6">

                <TextView
                    style="@style/Text.Giljabi.Heading"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/perm_overlay_title" />

                <TextView
                    style="@style/Text.Giljabi.Body"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_2"
                    android:textColor="@color/text_secondary"
                    android:text="@string/perm_overlay_desc" />

                <TextView
                    android:id="@+id/tvOverlayStatus"
                    style="@style/Text.Giljabi.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_3"
                    tools:text="상태: 꺼짐" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnOverlay"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/touch_comfortable"
                    android:layout_marginTop="@dimen/space_4"
                    android:text="@string/btn_open_overlay"
                    android:textSize="@dimen/text_button"
                    app:cornerRadius="@dimen/radius_md" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/tvAllReady"
            style="@style/Text.Giljabi.Guide"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_8"
            android:textColor="@color/text_success"
            android:visibility="gone"
            android:text="@string/all_ready"
            tools:visibility="visible" />

        <!-- 목표 선택 -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_8"
            app:cardBackgroundColor="@color/surface_brand_soft"
            app:cardCornerRadius="@dimen/radius_lg"
            app:strokeColor="@color/border_brand"
            app:strokeWidth="@dimen/border_width">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/space_6">

                <TextView
                    style="@style/Text.Giljabi.Heading"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/goal_section_title" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnStartTicket"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/touch_hero"
                    android:layout_marginTop="@dimen/space_4"
                    android:text="@string/goal_ticket_label"
                    android:textSize="@dimen/text_button"
                    app:cornerRadius="@dimen/radius_md" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            style="@style/Text.Giljabi.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_8"
            android:text="@string/m1_note" />

    </LinearLayout>
</ScrollView>
